{
    "name": "evently",
    "private": true,
    "description": "Frontend and Git tooling for Evently (not a package)",
    "scripts": {
        "format": "prettier --write --no-error-on-unmatched-pattern \"assets/**/*.{js,css}\" \".github/**/*.yml\" docker-compose.yml package.json .prettierrc.json README.md",
        "format:check": "prettier --check --no-error-on-unmatched-pattern \"assets/**/*.{js,css}\" \".github/**/*.yml\" docker-compose.yml package.json .prettierrc.json README.md",
        "prepare": "lefthook install"
    },
    "devDependencies": {
        "lefthook": "2.2.2",
        "prettier": "3.10.1"
    }
}
